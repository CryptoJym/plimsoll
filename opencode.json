{
 "$schema": "https://opencode.ai/config.json",
 "model": "opencode/x-preview-f-free",
 "mcp": {
  "railway": {
   "command": [
    "railway",
    "mcp",
    "proxy"
   ],
   "enabled": false,
   "type": "local"
  }
 },
 "permission": {
  "edit": "allow",
  "webfetch": "deny",
  "bash": {
   "git push*": "deny",
   "gh *": "deny",
   "railway *": "deny",
   "*": "allow"
  }
 },
 "snapshot": false
}